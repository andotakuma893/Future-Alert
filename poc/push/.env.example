# Copy to .env for local runs (never commit .env). On Render, set these in the Environment tab.
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service operator: mailto: address or https URL
VAPID_SUBJECT=mailto:you@example.com
# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Optional
# PORT=3000
# SUBSCRIPTIONS_FILE=./subscriptions.json
